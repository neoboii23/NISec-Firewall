# Copy these values into .local/cloud.env by running:
# powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/configure_cloud_env.ps1
SHOP_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres?sslmode=require
SHOP_DATABASE_SCHEMA=shop
SECURITY_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres?sslmode=require
SECURITY_DATABASE_SCHEMA=security
SECRET_KEY=replace-with-a-long-random-secret
VULNERABLE_MODE=false
LAB_MODE=false
