# Local lab defaults are generated in .local/.
# For Vercel, set these in the Vercel dashboard, not in a committed file.
SHOP_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
SHOP_DATABASE_SCHEMA=shop
SECURITY_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
SECURITY_DATABASE_SCHEMA=security
SECRET_KEY=replace-with-a-long-random-secret
VULNERABLE_MODE=false
LAB_MODE=false
